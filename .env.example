# Copy to .env.local and fill in. The two VITE_ values are safe in a public
# build: the publishable key only reaches data that row-level security allows.
# They are the same two values as the sleep app's .env.local.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only on the home PC: the token the weekly refresh uses to post picks.
# `npm run new-key` makes it. Never put it in the repo or the build.
WATCH_INGEST_TOKEN=
